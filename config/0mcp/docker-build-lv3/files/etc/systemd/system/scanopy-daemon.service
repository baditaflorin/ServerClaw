[Unit]
Description=Scanopy Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/scanopy-daemon --config-dir /etc/scanopy/daemon/scanopy-daemon --log-file /var/log/scanopy/scanopy-daemon.log
Restart=always
RestartSec=10
User=root
StandardOutput=journal
StandardError=journal
SyslogIdentifier=scanopy-daemon

[Install]
WantedBy=multi-user.target

#!/bin/sh
set -eu

export NOMAD_ADDR="${NOMAD_ADDR:-https://10.10.10.30:4646}"
export NOMAD_CACERT="${NOMAD_CACERT:-/etc/mcp/nomad/tls/nomad-agent-ca.pem}"

if [ -z "${NOMAD_TOKEN:-}" ] && [ -s "/etc/mcp/nomad/bootstrap-management.token" ]; then
  NOMAD_TOKEN="$(cat "/etc/mcp/nomad/bootstrap-management.token")"
  export NOMAD_TOKEN
fi

exec /usr/local/bin/nomad "$@"

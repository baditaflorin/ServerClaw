[Unit]
Description=Limit the LAN-published keystore API to the hosts in /etc/keystore-lan-allow.conf
Requires=docker.service
After=docker.service network-online.target
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/keystore-lan-firewall

[Install]
WantedBy=multi-user.target

#!/bin/bash
# keystore-lan-firewall: only the hosts listed in /etc/keystore-lan-allow.conf may reach the keystore API that
# the mesh node publishes on its LAN address (docker-compose: API_LAN_PUBLISH=<lan ip>:18021). Everything else
# that arrives on that interface for that address and port is dropped before Docker's own rules.
#
# One IPv4 address per line, '#' comments. No CIDR, no wildcard: a line that is not one address stops the run
# (the rules stay as they were). An empty list means everybody is dropped.
#
#   keystore-lan-firewall            apply (idempotent; also what the systemd unit runs)
#   keystore-lan-firewall --print    print the iptables-restore input and the jump rule, change nothing
#
# The chain is replaced in one iptables-restore --noflush transaction, so there is no moment with an empty chain.
set -euo pipefail

CONF=${KEYSTORE_LAN_ALLOW:-/etc/keystore-lan-allow.conf}
LAN_IP=${KEYSTORE_LAN_IP:-10.10.10.91}
PORT=${KEYSTORE_LAN_PORT:-18021}
IFACE=${KEYSTORE_LAN_IF:-eth0}
CHAIN=KEYSTORE-LAN
IPT=${IPTABLES:-iptables}
IPT_RESTORE=${IPTABLES_RESTORE:-iptables-restore}

mode=apply
[ "${1:-}" = "--print" ] && mode=print

allow=()
while IFS= read -r line || [ -n "$line" ]; do
  line=${line%%#*}
  line=$(echo $line)
  [ -n "$line" ] || continue
  if ! [[ $line =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
    echo "refusing '$line' in $CONF: one IPv4 address per line, no ranges or wildcards" >&2
    exit 2
  fi
  IFS=. read -r a b c d <<<"$line"
  for o in $a $b $c $d; do
    if [ "$o" -gt 255 ]; then echo "refusing '$line' in $CONF: not an IPv4 address" >&2; exit 2; fi
  done
  if [ "$line" = "0.0.0.0" ]; then echo "refusing 0.0.0.0 in $CONF" >&2; exit 2; fi
  allow+=("$line")
done < "$CONF"
[ ${#allow[@]} -gt 0 ] || echo "warning: no allowed hosts in $CONF, the port is closed to everybody" >&2

restore_input() {
  echo "*filter"
  echo ":$CHAIN - [0:0]"
  for s in "${allow[@]+"${allow[@]}"}"; do echo "-A $CHAIN -s $s -j RETURN"; done
  echo "-A $CHAIN -j DROP"
  echo "COMMIT"
}
jump=(-i "$IFACE" -p tcp -m conntrack --ctorigdst "$LAN_IP" --ctorigdstport "$PORT" --ctdir ORIGINAL -j "$CHAIN")

if [ "$mode" = print ]; then
  restore_input
  echo "jump: $IPT -I DOCKER-USER 1 ${jump[*]}"
  exit 0
fi

restore_input | "$IPT_RESTORE" --noflush
if ! "$IPT" -C DOCKER-USER "${jump[@]}" 2>/dev/null; then
  "$IPT" -I DOCKER-USER 1 "${jump[@]}"
fi
echo "keystore-lan-firewall: ${LAN_IP}:${PORT} on ${IFACE} open to: ${allow[*]:-nobody}"

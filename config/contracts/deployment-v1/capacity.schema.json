{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lv3.org/schemas/deployment-v1/capacity.json",
  "title": "Host Capacity",
  "description": "Per-deployment host capacity snapshot. Lives at .local/deployments/<slug>/capacity.yml. Generated by scripts/capacity_probe.py or operator-authored before bootstrap. ADR 0482.",
  "type": "object",
  "required": ["schema_version", "probed_at", "probed_via", "host"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": 1 },
    "probed_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp when this snapshot was taken."
    },
    "probed_via": {
      "enum": ["ssh", "proxmox-api", "operator"],
      "description": "How this snapshot was produced. 'operator' means hand-authored before host exists."
    },
    "host": {
      "type": "object",
      "required": ["ram_total_mb", "cores"],
      "additionalProperties": true,
      "properties": {
        "ram_total_mb": {
          "type": "integer",
          "minimum": 1024,
          "description": "Total physical RAM on the Proxmox host, in MB."
        },
        "ram_reserved_mb": {
          "type": "integer",
          "minimum": 0,
          "description": "RAM the resolver should leave for the host itself (Proxmox + ZFS ARC + headroom). Default 4096."
        },
        "cores": {
          "type": "integer",
          "minimum": 1,
          "description": "Physical CPU cores."
        },
        "threads": {
          "type": "integer",
          "minimum": 1,
          "description": "Logical CPU threads (with SMT). Defaults to cores if absent."
        },
        "storage": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "total_gb", "free_gb"],
            "additionalProperties": true,
            "properties": {
              "name":     { "type": "string" },
              "type":     { "enum": ["zfs", "lvm", "dir", "btrfs", "ceph", "other"] },
              "total_gb": { "type": "number", "minimum": 1 },
              "free_gb":  { "type": "number", "minimum": 0 }
            }
          }
        },
        "networks": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "public_ipv4":     { "type": "string", "format": "ipv4" },
            "public_ipv6":     { "type": "string", "format": "ipv6" },
            "private_bridges": { "type": "array", "items": { "type": "string" } }
          }
        },
        "capabilities": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Optional capability tags surfaced by the probe: ['gpu', 'nvme', 'ecc-ram', ...]. Sizing-policy classes can require capabilities via requires_capability."
        }
      }
    }
  }
}

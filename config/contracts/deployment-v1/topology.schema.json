{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lv3.org/schemas/deployment-v1/topology.json",
  "title": "Deployment Topology",
  "description": "Per-deployment infrastructure topology. Lives at .local/deployments/<slug>/topology.yml. Defines proxmox guests, network bridges, host IPs. Replaces inventory/host_vars/proxmox-host.yml. ADR 0440.",
  "type": "object",
  "required": [
    "proxmox_guests"
  ],
  "additionalProperties": true,
  "properties": {
    "host_public_ipv4": {
      "type": "string",
      "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}$",
      "description": "Proxmox host's public IPv4 address."
    },
    "host_public_ipv6": {
      "type": "string",
      "description": "Proxmox host's public IPv6 address (optional)."
    },
    "management_ipv4": {
      "type": "string",
      "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}$",
      "description": "IP that operator tooling SSHs to. Often equals host_public_ipv4."
    },
    "proxmox_guests": {
      "type": "array",
      "minItems": 1,
      "description": "List of guest VMs to provision on this Proxmox host. Each entry becomes an Ansible host.",
      "items": {
        "type": "object",
        "required": ["name", "vmid", "ipv4"],
        "additionalProperties": true,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "Guest hostname (DNS label shape)."
          },
          "vmid": {
            "type": "integer",
            "minimum": 100,
            "maximum": 999999,
            "description": "Proxmox VMID. Unique per host."
          },
          "ipv4": {
            "type": "string",
            "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}$",
            "description": "Internal LAN IPv4 (must fall inside platform_guest_network_cidr)."
          },
          "tags": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Free-form tags for inventory grouping."
          },
          "memory_mb": {"type": "integer", "minimum": 512},
          "cores": {"type": "integer", "minimum": 1},
          "deployment_owner": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "description": "ADR 0457 — slug of the deployment that owns this VM. When set, services from other deployments must not be installed/enabled on this host. Validated by scripts/host_pinning_check.py. Optional; when absent the VM is shared (legacy behavior)."
          }
        }
      }
    },
    "network_bridges": {
      "type": "object",
      "description": "Bridge definitions (vmbr0, vmbr10, vmbr20, etc.).",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "cidr": {"type": "string"},
          "vlan_aware": {"type": "boolean"},
          "comment": {"type": "string"}
        }
      }
    },
    "live_apply_evidence": {
      "type": "object",
      "description": "Per-deployment receipt index. Mirrors versions/stack.yaml::live_apply_evidence but scoped to this deployment.",
      "additionalProperties": true
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/deployment-v1/sizing-policy.json",
  "title": "Sizing Policy",
  "description": "Per-service-class resource allocation rules used by scripts/resolve_topology.py to compute per-VM allocations from host capacity. Committed at config/sizing-policy.yml. ADR 0482.",
  "type": "object",
  "required": ["schema_version", "classes", "priority_order"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": 1 },
    "priority_order": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "List of priority tier names in shrink-order. Resolver shrinks lowest-priority first when host is over-committed."
    },
    "classes": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_-]*$": {
          "type": "object",
          "required": ["priority", "cpu", "ram_mb", "disk_gb"],
          "additionalProperties": true,
          "properties": {
            "priority": { "type": "string" },
            "requires_capability": { "type": "string" },
            "cpu": {
              "type": "object",
              "required": ["min", "preferred", "max"],
              "properties": {
                "min":       { "type": "integer", "minimum": 1 },
                "preferred": { "type": "integer", "minimum": 1 },
                "max":       { "type": "integer", "minimum": 1 }
              }
            },
            "ram_mb": {
              "type": "object",
              "required": ["min", "preferred", "max"],
              "properties": {
                "min":       { "type": "integer", "minimum": 256 },
                "preferred": { "type": "integer", "minimum": 256 },
                "max":       { "type": "integer", "minimum": 256 }
              }
            },
            "disk_gb": {
              "type": "object",
              "required": ["min", "preferred", "max"],
              "properties": {
                "min":       { "type": "integer", "minimum": 4 },
                "preferred": { "type": "integer", "minimum": 4 },
                "max":       { "type": "integer", "minimum": 4 }
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "profile_defaults": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9_-]+$": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}

#!/bin/bash
# Print one secret from the LOCAL vault standby (stdout only; pipe it, never store it). Root only.
# Starts the standby if it is not running and stops it again afterwards; a standby that was already running (real promotion) is never stopped.
set -uo pipefail
NAME=${1:?secret name}
exec 9>/run/vault-standby-drill.lock; flock -w 180 9 || { echo "vault standby is busy (drill running?)" >&2; exit 5; }   # same lock as the weekly drill
D=/opt/tier0/vault-standby; cd "$D" || exit 1
started=0
if [ "$(docker-compose ps --status running -q 2>/dev/null | wc -l)" -eq 0 ]; then
  # The copy ages DURING an outage by definition (the builder that syncs it is down): age is a warning, never a stop. Only a missing copy is fatal.
  for d in vault keystore; do f=data/$d/.last_sync; [ -f "$f" ] || { echo "standby $d copy missing" >&2; exit 3; }
    age=$(( $(date +%s) - $(cat "$f") )); [ $age -le 7200 ] || echo "warning: standby $d copy is $(( age / 60 )) min old (expected during an outage)" >&2; done
  docker-compose up -d keystore >/dev/null 2>&1 || exit 4; sleep 6; docker-compose up -d vault >/dev/null 2>&1 || exit 4; started=1
fi
trap '[ $started = 1 ] && docker-compose stop >/dev/null 2>&1' EXIT
for i in $(seq 1 20); do curl -fsS -m3 http://127.0.0.1:18140/health 2>/dev/null | grep -q '"status":"ok"' && break; sleep 2; done
python3 /opt/tier0-runner/bin/tier0_secret.py "$NAME"

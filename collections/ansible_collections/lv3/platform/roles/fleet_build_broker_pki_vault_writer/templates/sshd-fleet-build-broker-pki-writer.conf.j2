# managed-by: role=fleet_build_broker_pki_vault_writer adr=0042,0047,0101
# This account can authenticate only with the single root-owned forced-command
# key file. Per-key restrictions independently deny shell, forwarding, user rc,
# and environment injection; PermitUserEnvironment is deliberately absent
# because OpenSSH rejects that global-only directive inside a Match block.
Match User {{ fleet_build_broker_pki_vault_writer_user }}
    AuthorizedKeysFile {{ fleet_build_broker_pki_vault_writer_authorized_keys_path }}
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    PermitTTY no
    AllowTcpForwarding no
    X11Forwarding no
    PermitTunnel no
    GatewayPorts no

# End the account-specific policy explicitly. This prevents any later sshd
# include from accidentally inheriting restrictions intended only for this user.
Match all

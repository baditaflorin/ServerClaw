#!/bin/bash
# managed-by: role=agent_history_runtime adr=0494 agent={{ lookup('env', 'LV3_AGENT_SESSION') | default('operator') }}
# Count, per database column, the rows that hold one of the redaction canary's fake secrets, and write textfile metrics
# (ADR 0494). The store's API never returns `raw`, so only the database can show a leak that is only in `raw`.
# The SQL file is generated by agent-eval's scripts/dbscan for one canary host and delivered by the owner. It prints
# only counts and column names. Exit 0 clean, 1 a leak, 3 the canary is not in the database, 4 the scan could not run.
set -uo pipefail

sql="{{ agent_history_canary_scan_sql_file }}"
out="{{ agent_history_textfile_dir }}/agent_history_canary.prom"
label='host="{{ agent_history_canary_scan_host }}",source="dbscan"'
now="$(date +%s)"
tmp="$(mktemp "{{ agent_history_textfile_dir }}/.agent_history_canary.XXXXXX")"
trap 'rm -f "$tmp"' EXIT

prev() { grep "^$1{" "$out" 2>/dev/null | awk '{print $2}' | head -1; }
leaks="$(prev agent_history_canary_leaks)"; leaks="${leaks:-0}"
last_ok="$(prev agent_history_canary_last_success_timestamp_seconds)"; last_ok="${last_ok:-0}"
code=4

if result="$(docker exec -i agent-history-db psql -U agent_history -d agent_history -v ON_ERROR_STOP=1 -At -F '|' <"$sql" 2>/dev/null)"; then
  found="$(printf '%s\n' "$result" | awk -F'|' '$1 != "events (all)" && $2 ~ /^[0-9]+$/ { s += $2 } END { print s + 0 }')"
  seen="$(printf '%s\n' "$result" | awk -F'|' '$1 == "events (all)" && $2 ~ /^[0-9]+$/ { s += $2 } END { print s + 0 }')"
  if [ "$found" -gt 0 ]; then
    leaks="$found"; code=1
  elif [ "$seen" -eq 0 ]; then
    leaks=0; code=3
  else
    leaks=0; code=0; last_ok="$now"
  fi
fi

{
  echo "# HELP agent_history_canary_leaks Places in the database where a redaction canary secret was found by the last scan (a scan that could not run keeps the previous value)."
  echo "# TYPE agent_history_canary_leaks gauge"
  echo "agent_history_canary_leaks{$label} $leaks"
  echo "# HELP agent_history_canary_last_success_timestamp_seconds Unix time of the last scan that found the canary and no leak (0 if never)."
  echo "# TYPE agent_history_canary_last_success_timestamp_seconds gauge"
  echo "agent_history_canary_last_success_timestamp_seconds{$label} $last_ok"
  echo "# HELP agent_history_canary_last_run_timestamp_seconds Unix time of the last scan attempt."
  echo "# TYPE agent_history_canary_last_run_timestamp_seconds gauge"
  echo "agent_history_canary_last_run_timestamp_seconds{$label} $now"
  echo "# HELP agent_history_canary_last_exit_code Exit code of the last scan: 0 clean, 1 leak, 3 canary absent, 4 scan failed."
  echo "# TYPE agent_history_canary_last_exit_code gauge"
  echo "agent_history_canary_last_exit_code{$label} $code"
} >"$tmp"

chmod 0644 "$tmp"
mv -f "$tmp" "$out"
trap - EXIT
exit "$code"

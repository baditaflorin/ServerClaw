# Traefik file-provider dynamic config — {{ _app_name }} extra service routes
# Generated by coolify_app_deploy role (ws-0447 t3, ADR 0477).
# Regenerated on every converge run; safe to overwrite.
#
# Why this file exists:
#   Coolify only adds Traefik Docker-provider labels to the service that receives the
#   public domain (e.g. catalog-web). Backend services (e.g. catalog-api) have no labels,
#   so all traffic goes to the frontend and /api/ calls are either proxied by the frontend
#   nginx or dropped. This file-provider config adds explicit routes for each extra service,
#   using the container name discovered at deploy time rather than a hardcoded IP.
#
# Note on Traefik v3 file-provider syntax:
#   MUST use double-quote syntax for matcher args — backticks are silently discarded
#   in the file provider (they work in Docker labels but not here). See ADR 0477.
http:
  routers:
{% for route in _extra_routes %}
    {{ _app_name }}-{{ route.service }}-router:
      rule: 'Host("{{ _public_domain }}") && PathPrefix("{{ route.path_prefix }}")'
      entryPoints:
        - http
        - https
      service: {{ _app_name }}-{{ route.service }}-svc
      priority: {{ route.priority | default(200) }}
      tls: {}
{% endfor %}

  services:
{% for route in _extra_routes %}
    {{ _app_name }}-{{ route.service }}-svc:
      loadBalancer:
        servers:
          - url: "http://{{ route._resolved_name }}:{{ route.port }}"
{% endfor %}

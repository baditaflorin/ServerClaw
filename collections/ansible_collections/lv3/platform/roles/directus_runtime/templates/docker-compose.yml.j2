{% from 'compose_macros.j2' import hairpin_hosts, openbao_sidecar %}
services:
{{ openbao_sidecar("directus") }}

  directus:
    image: {{ directus_image }}
    container_name: {{ directus_container_name }}
    restart: unless-stopped
    depends_on:
      openbao-agent:
        condition: service_healthy
{% if directus_public_hostname_overrides | default([]) | length > 0 %}
    extra_hosts:
{% for entry in directus_public_hostname_overrides %}
      - "{{ entry.hostname }}:{{ entry.address }}"
{% endfor %}
{% else %}
{{ hairpin_hosts() }}
{% endif %}
    env_file:
      - {{ directus_env_file }}
    ports:
      - "{{ ansible_host }}:{{ directus_internal_port }}:{{ directus_container_port }}"
      - "127.0.0.1:{{ directus_internal_port }}:{{ directus_container_port }}"

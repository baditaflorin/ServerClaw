HOST=0.0.0.0
PORT={{ directus_container_port }}
PUBLIC_URL={{ directus_public_base_url }}
SERVE_APP=true
TELEMETRY=false
DB_CLIENT=pg
DB_HOST={{ directus_database_host }}
DB_PORT=5432
DB_DATABASE={{ directus_database_name }}
DB_USER={{ directus_database_user }}
DB_PASSWORD=[[ with secret "kv/data/{{ directus_openbao_secret_path }}" ]][[ .Data.data.DB_PASSWORD ]][[ end ]]
KEY=[[ with secret "kv/data/{{ directus_openbao_secret_path }}" ]][[ .Data.data.KEY ]][[ end ]]
SECRET=[[ with secret "kv/data/{{ directus_openbao_secret_path }}" ]][[ .Data.data.SECRET ]][[ end ]]
ADMIN_EMAIL={{ directus_admin_email }}
ADMIN_PASSWORD=[[ with secret "kv/data/{{ directus_openbao_secret_path }}" ]][[ .Data.data.ADMIN_PASSWORD ]][[ end ]]
AUTH_PROVIDERS=authentik
AUTH_AUTHENTIK_DRIVER=openid
AUTH_AUTHENTIK_MODE=session
AUTH_AUTHENTIK_LABEL={{ directus_authentik_label }}
AUTH_AUTHENTIK_ICON={{ directus_authentik_icon }}
AUTH_AUTHENTIK_CLIENT_ID={{ directus_authentik_client_id }}
AUTH_AUTHENTIK_CLIENT_SECRET=[[ with secret "kv/data/{{ directus_openbao_secret_path }}" ]][[ .Data.data.AUTH_AUTHENTIK_CLIENT_SECRET ]][[ end ]]
AUTH_AUTHENTIK_ISSUER_URL={{ directus_authentik_issuer_url }}
AUTH_AUTHENTIK_ALLOW_PUBLIC_REGISTRATION={{ 'true' if directus_authentik_allow_public_registration else 'false' }}
AUTH_AUTHENTIK_DEFAULT_ROLE_ID={{ directus_observer_role_id }}
AUTH_AUTHENTIK_ROLE_MAPPING={{ directus_authentik_role_mapping_json }}
AUTH_AUTHENTIK_GROUP_CLAIM_NAME={{ directus_authentik_group_claim_name }}
AUTH_AUTHENTIK_EMAIL_KEY={{ directus_authentik_email_key }}
AUTH_AUTHENTIK_FIRST_NAME_KEY={{ directus_authentik_first_name_key }}
AUTH_AUTHENTIK_LAST_NAME_KEY={{ directus_authentik_last_name_key }}
AUTH_AUTHENTIK_SYNC_USER_INFO={{ 'true' if directus_authentik_sync_user_info else 'false' }}

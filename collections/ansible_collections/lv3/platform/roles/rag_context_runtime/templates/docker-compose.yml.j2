# managed-by: role=rag_context_runtime adr=0070 agent={{ lookup('env', 'LV3_AGENT_SESSION') | default('operator') }}
{% from 'compose_macros.j2' import openbao_sidecar %}
services:
{{ openbao_sidecar("platform_context") }}

  qdrant:
    image: {{ platform_context_qdrant_image }}
    container_name: qdrant-platform-context
    restart: unless-stopped
{% if platform_context_qdrant_host_port | default(0) | int > 0 %}
    ports:
      - "127.0.0.1:{{ platform_context_qdrant_host_port }}:6333"
{% endif %}
    volumes:
      - {{ platform_context_data_dir }}:/qdrant/storage
    healthcheck:
      test: ["CMD-SHELL", "curl --fail --silent --show-error http://127.0.0.1:6333/healthz || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 10s

  platform-context-api:
    build:
      context: {{ platform_context_service_dir }}
      network: host
    image: {{ platform_context_api_image_name }}:latest
    container_name: platform-context-api
    restart: unless-stopped
    depends_on:
      qdrant:
        condition: service_healthy
    env_file:
      - {{ platform_context_env_file }}
    volumes:
      - {{ platform_context_corpus_dir }}:{{ platform_context_corpus_dir }}:ro
    ports:
      - "{{ platform_context_internal_port }}:8010"

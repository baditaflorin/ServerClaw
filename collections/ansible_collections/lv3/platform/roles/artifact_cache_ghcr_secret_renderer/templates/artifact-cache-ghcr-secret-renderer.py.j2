#!/usr/bin/env python3
"""Render the one fixed private GHCR Docker Distribution configuration.

The only credential entering this process is a transient reader received on a
pinned SSH stdio channel. It is never written to disk, command arguments,
environment variables, receipts, or diagnostics. The reader bridge revokes it
when this process acknowledges success or failure.
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
from pathlib import Path
import re
import select
import ssl
import stat
import subprocess
import sys
import tempfile
from typing import Any
from urllib import error, request


CONFIG_PATH = Path("/etc/artifact-cache/ghcr-proxy-renderer/contract.json")
VAULT_URL = "https://fleet-secrets.0exec.com"
SECRET_NAME = "artifact_cache_ghcr_proxy_config"
OUTPUT_PARENT_DIRS = (Path("/etc/artifact-cache"), Path("/etc/artifact-cache/ghcr-proxy"))
OUTPUT_PATH = Path("/etc/artifact-cache/ghcr-proxy/config.yml")
RECEIPT_PATH = Path("/var/lib/artifact-cache/ghcr-proxy-renderer/last-render.json")
BRIDGE_USER = "artifact-cache-ghcr-reader"
MAX_RESPONSE_BYTES = 64 * 1024
MAX_PROTOCOL_LINE_BYTES = 128
NETWORK_TIMEOUT_SECONDS = 15
PROTOCOL_TIMEOUT_SECONDS = 20
KEY_PATTERN = re.compile(r"ak_[0-9a-f]{32}\Z")
SAFE_USERNAME_PATTERN = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,255}\Z")


class RenderError(RuntimeError):
    """Safe failure classification with no secret-bearing details."""


class NoRedirect(request.HTTPRedirectHandler):
    """The secret read must never follow an authenticated redirect."""

    def redirect_request(self, req: request.Request, fp: Any, code: int, msg: str, headers: Any, newurl: str) -> None:
        del req, fp, code, msg, headers, newurl
        return None


def _require(condition: bool, message: str) -> None:
    if not condition:
        raise RenderError(message)


def _safe_root_dir(path: Path, modes: set[int] | None = None) -> None:
    try:
        metadata = path.lstat()
    except OSError as exc:
        raise RenderError("required root-owned directory is unavailable") from exc
    _require(stat.S_ISDIR(metadata.st_mode), "required root-owned path is not a directory")
    _require(metadata.st_uid == 0 and metadata.st_gid == 0, "required root-owned directory has unsafe ownership")
    mode = stat.S_IMODE(metadata.st_mode)
    _require(mode & 0o022 == 0, "required root-owned directory is writable by another principal")
    if modes is not None:
        _require(mode in modes, "required root-owned directory has unsafe permissions")


def _safe_regular_root_file(path: Path, modes: set[int]) -> None:
    parent = path.parent
    while True:
        _safe_root_dir(parent)
        if parent == parent.parent:
            break
        parent = parent.parent
    try:
        metadata = path.lstat()
    except OSError as exc:
        raise RenderError("required root-owned file is unavailable") from exc
    _require(stat.S_ISREG(metadata.st_mode), "required root-owned path is not a regular file")
    _require(metadata.st_uid == 0 and metadata.st_gid == 0, "required root-owned file has unsafe ownership")
    _require(stat.S_IMODE(metadata.st_mode) in modes, "required root-owned file has unsafe permissions")


def _safe_ipv4(value: Any) -> str:
    _require(isinstance(value, str), "bridge host is invalid")
    parts = value.split(".")
    _require(len(parts) == 4 and all(part.isdigit() and 0 <= int(part) <= 255 for part in parts), "bridge host is invalid")
    return value


def _exact_path(value: Any, expected: Path, name: str) -> str:
    _require(value == str(expected), f"{name} changed")
    return str(expected)


def _validate_config(config: Any) -> dict[str, Any]:
    _require(isinstance(config, dict), "renderer configuration must be an object")
    _require(set(config) == {"managed-by", "schema_version", "bridge", "vault", "output"}, "renderer configuration has unexpected fields")
    _require(config.get("schema_version") == 1, "unsupported renderer configuration schema")

    bridge = config.get("bridge")
    _require(isinstance(bridge, dict) and set(bridge) == {"host", "port", "user", "private_key", "known_hosts"}, "bridge contract changed")
    _safe_ipv4(bridge.get("host"))
    _require(bridge.get("port") == 22, "bridge port changed")
    _require(bridge.get("user") == BRIDGE_USER, "bridge user changed")
    _require(bridge.get("private_key") == str(CONFIG_PATH.parent / "bridge-id_ed25519"), "bridge private key path changed")
    _require(bridge.get("known_hosts") == str(CONFIG_PATH.parent / "bridge-known_hosts"), "bridge known-hosts path changed")

    vault = config.get("vault")
    _require(isinstance(vault, dict) and set(vault) == {"url", "secret_name"}, "vault contract changed")
    _require(vault.get("url") == VAULT_URL, "vault endpoint changed")
    _require(vault.get("secret_name") == SECRET_NAME, "vault record changed")

    output = config.get("output")
    _require(isinstance(output, dict) and set(output) == {"parent_dirs", "path", "receipt"}, "output contract changed")
    _require(output.get("parent_dirs") == [str(path) for path in OUTPUT_PARENT_DIRS], "output parent directories changed")
    _exact_path(output.get("path"), OUTPUT_PATH, "output path")
    _exact_path(output.get("receipt"), RECEIPT_PATH, "receipt path")
    return config


def _load_config(path: Path, *, render: bool) -> dict[str, Any]:
    if render:
        _require(path == CONFIG_PATH, "renderer configuration path changed")
    _safe_regular_root_file(path, {0o600})
    try:
        config = json.loads(path.read_bytes())
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise RenderError("unable to load renderer configuration") from exc
    return _validate_config(config)


def _read_protocol_line(stream: Any) -> bytes:
    try:
        ready, _, _ = select.select([stream], [], [], PROTOCOL_TIMEOUT_SECONDS)
    except (OSError, ValueError) as exc:
        raise RenderError("reader bridge protocol is unavailable") from exc
    _require(bool(ready), "reader bridge protocol timed out")
    try:
        line = stream.readline(MAX_PROTOCOL_LINE_BYTES)
    except OSError as exc:
        raise RenderError("reader bridge protocol read failed") from exc
    _require(bool(line) and len(line) < MAX_PROTOCOL_LINE_BYTES, "reader bridge protocol frame is invalid")
    return line


def _open_reader_bridge(bridge: dict[str, Any]) -> subprocess.Popen[bytes]:
    private_key = Path(bridge["private_key"])
    known_hosts = Path(bridge["known_hosts"])
    _safe_regular_root_file(private_key, {0o400})
    _safe_regular_root_file(known_hosts, {0o444})
    argv = [
        "/usr/bin/ssh",
        "-T",
        "-F",
        "/dev/null",
        "-i",
        str(private_key),
        "-o",
        "IdentitiesOnly=yes",
        "-o",
        f"UserKnownHostsFile={known_hosts}",
        "-o",
        "GlobalKnownHostsFile=/dev/null",
        "-o",
        "StrictHostKeyChecking=yes",
        "-o",
        "BatchMode=yes",
        "-o",
        "PasswordAuthentication=no",
        "-o",
        "KbdInteractiveAuthentication=no",
        "-o",
        "PermitLocalCommand=no",
        "-o",
        "RequestTTY=no",
        "-p",
        str(bridge["port"]),
        f"{bridge['user']}@{bridge['host']}",
        "reader",
    ]
    try:
        return subprocess.Popen(
            argv,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            close_fds=True,
            env={"HOME": "/nonexistent", "LANG": "C", "PATH": "/usr/bin:/bin"},
        )
    except OSError as exc:
        raise RenderError("unable to start reader bridge") from exc


def _request_reader(process: subprocess.Popen[bytes]) -> str:
    _require(process.stdin is not None and process.stdout is not None, "reader bridge pipes are unavailable")
    try:
        process.stdin.write(b"REQUEST\n")
        process.stdin.flush()
    except OSError as exc:
        raise RenderError("reader bridge request failed") from exc
    line = _read_protocol_line(process.stdout)
    _require(line.startswith(b"READER ") and line.endswith(b"\n"), "reader bridge response is invalid")
    try:
        reader_key = line[len(b"READER ") : -1].decode("ascii")
    except UnicodeDecodeError as exc:
        raise RenderError("reader bridge response is invalid") from exc
    _require(KEY_PATTERN.fullmatch(reader_key) is not None, "reader bridge response is invalid")
    return reader_key


def _finish_reader_bridge(process: subprocess.Popen[bytes], *, completed: bool) -> None:
    _require(process.stdin is not None, "reader bridge input is unavailable")
    try:
        process.stdin.write(b"CONSUMED\n" if completed else b"FAILED\n")
        process.stdin.flush()
        process.stdin.close()
        return_code = process.wait(timeout=PROTOCOL_TIMEOUT_SECONDS)
    except (OSError, subprocess.TimeoutExpired) as exc:
        process.kill()
        process.wait(timeout=PROTOCOL_TIMEOUT_SECONDS)
        raise RenderError("reader bridge did not complete revocation") from exc
    _require(return_code == 0, "reader bridge did not complete revocation")


def _fetch_configuration(reader_key: str) -> str:
    req = request.Request(
        f"{VAULT_URL}/secrets/{SECRET_NAME}",
        headers={
            "X-API-Key": reader_key,
            "X-Expected-Scope": "infra-privileged",
            "X-Required-Tier": "infra-privileged",
        },
        method="GET",
    )
    opener = request.build_opener(
        request.ProxyHandler({}),
        request.HTTPSHandler(context=ssl.create_default_context()),
        NoRedirect(),
    )
    try:
        with opener.open(req, timeout=NETWORK_TIMEOUT_SECONDS) as response:
            _require(response.status == 200, "vault response status is invalid")
            content_length = response.headers.get("Content-Length")
            if content_length is not None:
                _require(content_length.isdigit() and int(content_length) <= MAX_RESPONSE_BYTES, "vault response exceeds boundary")
            raw = response.read(MAX_RESPONSE_BYTES + 1)
            _require(len(raw) <= MAX_RESPONSE_BYTES, "vault response exceeds boundary")
    except (error.HTTPError, error.URLError, TimeoutError, OSError) as exc:
        raise RenderError("fixed vault read failed") from exc
    try:
        envelope = json.loads(raw)
        data = envelope["data"]
        value = data["value"]
        _require(envelope.get("status") == "success" and set(envelope) == {"status", "data"}, "vault response is invalid")
        _require(isinstance(data, dict) and set(data) == {"name", "value"}, "vault response is invalid")
        _require(data.get("name") == SECRET_NAME and isinstance(value, str), "vault response is invalid")
        _require(bool(value) and len(value.encode("utf-8")) <= MAX_RESPONSE_BYTES, "vault response is invalid")
        return value
    except (KeyError, TypeError, UnicodeDecodeError, json.JSONDecodeError, RenderError) as exc:
        if isinstance(exc, RenderError):
            raise
        raise RenderError("vault response is invalid") from exc


def _no_control(value: Any, name: str, *, maximum: int) -> str:
    _require(isinstance(value, str) and bool(value) and len(value.encode("utf-8")) <= maximum, f"{name} is invalid")
    _require("\x00" not in value and "\r" not in value and "\n" not in value, f"{name} is invalid")
    return value


def _validate_distribution_config(raw: str) -> dict[str, Any]:
    try:
        config = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise RenderError("GHCR proxy configuration is invalid") from exc
    _require(isinstance(config, dict) and set(config) == {"version", "log", "storage", "http", "proxy"}, "GHCR proxy configuration shape changed")
    _require(config.get("version") == "0.1", "GHCR proxy configuration version changed")

    log = config.get("log")
    _require(isinstance(log, dict) and log == {"level": "warn"}, "GHCR proxy log configuration changed")

    storage = config.get("storage")
    _require(isinstance(storage, dict) and set(storage) == {"filesystem", "delete"}, "GHCR proxy storage configuration changed")
    _require(storage.get("filesystem") == {"rootdirectory": "/var/lib/registry"}, "GHCR proxy storage path changed")
    _require(storage.get("delete") == {"enabled": True}, "GHCR proxy delete policy changed")

    http = config.get("http")
    _require(http == {"addr": "0.0.0.0:5000"}, "GHCR proxy listener changed")

    proxy = config.get("proxy")
    _require(isinstance(proxy, dict) and set(proxy) == {"remoteurl", "username", "password"}, "GHCR proxy configuration changed")
    _require(proxy.get("remoteurl") == "https://ghcr.io", "GHCR proxy upstream changed")
    username = _no_control(proxy.get("username"), "GHCR proxy username", maximum=256)
    _require(SAFE_USERNAME_PATTERN.fullmatch(username) is not None, "GHCR proxy username is invalid")
    _no_control(proxy.get("password"), "GHCR proxy password", maximum=4096)
    return config


def _atomic_write(path: Path, payload: bytes, *, mode: int) -> None:
    _safe_root_dir(path.parent, {0o700})
    if path.exists() or path.is_symlink():
        _safe_regular_root_file(path, {mode})
    descriptor = -1
    temporary_path: Path | None = None
    try:
        descriptor, temporary_name = tempfile.mkstemp(prefix=".render-", dir=path.parent)
        temporary_path = Path(temporary_name)
        os.fchmod(descriptor, mode)
        with os.fdopen(descriptor, "wb", closefd=True) as handle:
            descriptor = -1
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary_path, path)
        directory_descriptor = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory_descriptor)
        finally:
            os.close(directory_descriptor)
        _safe_regular_root_file(path, {mode})
    except OSError as exc:
        raise RenderError("atomic render write failed") from exc
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        if temporary_path is not None:
            try:
                temporary_path.unlink()
            except FileNotFoundError:
                pass


def _write_output(config: dict[str, Any]) -> None:
    for parent in OUTPUT_PARENT_DIRS:
        _safe_root_dir(parent, {0o700})
    _safe_root_dir(RECEIPT_PATH.parent, {0o700})
    payload = json.dumps(config, sort_keys=True, indent=2, separators=(",", ": ")).encode("utf-8") + b"\n"
    _atomic_write(OUTPUT_PATH, payload, mode=0o400)
    # The receipt deliberately contains no secret-derived values, identifiers,
    # response metadata, or hashes. It only records that the fixed renderer
    # completed a single atomic file replacement.
    receipt = json.dumps(
        {
            "schema_version": 1,
            "status": "rendered",
            "renderer": "artifact-cache-ghcr-secret-renderer",
            "target": str(OUTPUT_PATH),
            "rendered_at": dt.datetime.now(dt.UTC).isoformat().replace("+00:00", "Z"),
        },
        sort_keys=True,
        separators=(",", ":"),
    ).encode("utf-8") + b"\n"
    _atomic_write(RECEIPT_PATH, receipt, mode=0o400)


def _render(config: dict[str, Any]) -> None:
    _require(os.geteuid() == 0, "renderer must run as root")
    process = _open_reader_bridge(config["bridge"])
    completed = False
    primary_error: RenderError | None = None
    try:
        reader_key = _request_reader(process)
        rendered = _validate_distribution_config(_fetch_configuration(reader_key))
        _write_output(rendered)
        completed = True
    except (RenderError, OSError, ValueError) as exc:
        primary_error = exc if isinstance(exc, RenderError) else RenderError("fixed renderer operation failed")
    bridge_error: RenderError | None = None
    try:
        _finish_reader_bridge(process, completed=completed)
    except RenderError as exc:
        bridge_error = exc
    if bridge_error is not None:
        raise bridge_error
    if primary_error is not None:
        raise primary_error


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Fixed artifact-cache GHCR secret renderer")
    parser.add_argument("--config", type=Path, default=CONFIG_PATH)
    parser.add_argument("--check-config", action="store_true")
    parser.add_argument("command", nargs="?")
    args = parser.parse_args(argv)
    try:
        if args.check_config:
            _require(args.command is None, "check mode accepts no render command")
            _load_config(args.config, render=False)
            print(json.dumps({"status": "valid"}, sort_keys=True))
            return 0
        _require(args.command == "render", "only the fixed render command is permitted")
        config = _load_config(args.config, render=True)
        _render(config)
        return 0
    except RenderError:
        # Avoid error details because malformed remote payloads, network
        # libraries, and authentication paths may include secret material.
        print("artifact-cache GHCR secret renderer failed", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())

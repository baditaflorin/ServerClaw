#!/usr/sbin/nft -f

# Replace only the table owned by this role. A global flush deletes Docker's
# independently managed NAT/filter tables and forces a disruptive daemon restart.
destroy table inet filter
destroy table ip lv3_container_private_edge_snat
destroy table ip lv3_container_snat
{% if inventory_hostname == 'coolify' %}
# Retire the unmanaged Coolify-only SNAT tables after their exact active flows
# have moved into the role-owned table below. nft's destroy is idempotent.
destroy table ip coolify_egress
destroy table ip coolify_dns_egress
{% endif %}

{% set policy = linux_guest_firewall_policy %}
{% set guest_ip_map = linux_guest_firewall_guest_ip_map %}
{% set guest_role_map = linux_guest_firewall_guest_role_map %}
{% set guest_policy = policy.guests[inventory_hostname] %}
{% set docker_forward_cidrs = docker_runtime_container_forward_source_cidrs | default(linux_guest_firewall_container_forward_source_cidrs) %}
{% macro render_match(rule) -%}
{% if rule.protocol == 'vrrp' -%}
ip protocol vrrp
{%- elif rule.protocol == 'icmp' -%}
icmp type echo-request
{%- else -%}
{{ rule.protocol }} dport { {{ rule.ports | map('string') | map('replace', ':', '-') | join(', ') }} }
{%- endif %}
{%- endmacro %}
{% macro render_rule(rule) -%}
{% if rule.source == 'public' %}
    {{ render_match(rule) }} accept
{% elif rule.source == 'management' %}
{% for source in policy.guest_management_sources %}
    ip saddr {{ source }} {{ render_match(rule) }} accept
{% endfor %}
{% elif rule.source == 'host' %}
    ip saddr {{ policy.host_source }} {{ render_match(rule) }} accept
{% elif rule.source == 'all_guests' %}
{% for guest_name, guest_ip in guest_ip_map.items() | sort if guest_name != inventory_hostname %}
    ip saddr {{ guest_ip }}/32 {{ render_match(rule) }} accept
{% endfor %}
{% elif rule.source in guest_ip_map %}
    ip saddr {{ guest_ip_map[rule.source] }}/32 {{ render_match(rule) }} accept
{% elif rule.source in hostvars and hostvars[rule.source].ansible_host is defined %}
    ip saddr {{ hostvars[rule.source].ansible_host }}/32 {{ render_match(rule) }} accept
{% else %}
    ip saddr {{ rule.source }} {{ render_match(rule) }} accept
{% endif %}
{%- endmacro %}
{% macro render_forward_rule(rule) -%}
{% if rule.source == 'public' %}
    accept
{% elif rule.source == 'management' %}
{% for source in policy.guest_management_sources %}
    ip saddr {{ source }} accept
{% endfor %}
{% elif rule.source == 'host' %}
    ip saddr {{ policy.host_source }} accept
{% elif rule.source == 'all_guests' %}
{% for guest_name, guest_ip in guest_ip_map.items() | sort if guest_name != inventory_hostname %}
    ip saddr {{ guest_ip }}/32 accept
{% endfor %}
{% elif rule.source in guest_ip_map %}
    ip saddr {{ guest_ip_map[rule.source] }}/32 accept
{% elif rule.source in hostvars and hostvars[rule.source].ansible_host is defined %}
    ip saddr {{ hostvars[rule.source].ansible_host }}/32 accept
{% else %}
    ip saddr {{ rule.source }} accept
{% endif %}
{%- endmacro %}

table inet filter {
  chain input {
    type filter hook input priority 0;
    policy drop;

    iifname "lo" accept
    ct state established,related accept
{% for rule in guest_policy.allowed_inbound %}
{{ render_rule(rule) }}
{% endfor %}
  }

  chain forward {
    type filter hook forward priority 0;
    policy drop;
    ct state established,related accept
{% if guest_role_map[inventory_hostname] in ['docker-runtime', 'docker-build'] or guest_policy.allow_container_forwarding | default(false) %}
{% for cidr in docker_forward_cidrs %}
    ip saddr {{ cidr }} accept
{% endfor %}
{% for rule in guest_policy.allowed_inbound if rule.forward | default(true) %}
{{ render_forward_rule(rule) }}
{% endfor %}
{% else %}
{% for rule in guest_policy.allowed_inbound %}
{{ render_rule(rule) }}
{% endfor %}
{% endif %}
  }

  chain output {
    type filter hook output priority 0;
    policy accept;
  }
}

{% if guest_policy.allow_container_private_edge_https_snat | default(false) or guest_policy.container_snat_rules | default([]) | length > 0 %}
# SNAT is allowed only for the explicit source/destination/protocol/port tuples
# below. It provides a routable return path without general container egress.
table ip lv3_container_snat {
  chain postrouting {
    type nat hook postrouting priority srcnat + 1; policy accept;
{% for cidr in guest_policy.container_private_edge_https_snat_source_cidrs | default([]) %}
    ip saddr {{ cidr }} ip daddr {{ hostvars[linux_guest_firewall_host_id].proxmox_public_edge_ipv4 }} tcp dport 443 snat to {{ guest_ip_map[inventory_hostname] }}
{% endfor %}
{% for rule in guest_policy.container_snat_rules | default([]) %}
{% set destination_ip = guest_ip_map[rule.destination] if rule.destination in guest_ip_map else rule.destination %}
    ip saddr {{ rule.source }} ip daddr {{ destination_ip }} {{ render_match(rule) }} snat to {{ guest_ip_map[inventory_hostname] }}
{% endfor %}
  }
}
{% endif %}

# managed-by: role=openbao_runtime adr=0491 agent={{ lookup('env', 'LV3_AGENT_SESSION') | default('operator', true) }}
# Generated from platform_service_registry entries with needs_openbao=true.
# This identity can write runtime payloads and mint credentials for pre-created
# service AppRoles.  It cannot create/update policies or AppRole definitions.
{% for contract in openbao_runtime_secret_service_contracts %}
path "kv/data/{{ contract.secret_path }}" {
  capabilities = ["create", "read", "update"]
}

path "auth/approle/role/{{ contract.approle_name }}/role-id" {
  capabilities = ["read"]
}

path "auth/approle/role/{{ contract.approle_name }}/secret-id" {
  capabilities = ["create", "update"]
}

{% endfor %}

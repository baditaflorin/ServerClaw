# managed-by: role=monitoring_vm adr=0011 agent={{ lookup('env','LV3_AGENT_SESSION') | default('operator') }}
{% macro resolve_probe_target(service, probe, host_patterns, execution_env, hostvars) -%}
{%- set target = probe.url -%}
{%- set owner_vm = service.owning_vm | default('') -%}
{%- set aliases = {'nginx': 'nginx_edge', 'proxmox-host': 'proxmox_hosts'} -%}
{%- set owner_key = aliases.get(owner_vm, owner_vm | replace('-', '_')) -%}
{%- set owner_pattern = host_patterns.get(owner_key, {}).get(execution_env, '') -%}
{%- set owner_host = '' -%}
{%- if owner_pattern and '&' not in owner_pattern and owner_pattern in hostvars -%}
{%- set owner_host = hostvars[owner_pattern].get('ansible_host', '') -%}
{%- endif -%}
{%- if owner_host and owner_vm != 'monitoring' and target.startswith('http://127.0.0.1:') -%}
{%- set target = target | replace('127.0.0.1', owner_host) -%}
{%- endif -%}
{{ target }}
{%- endmacro %}

[Unit]
Description=Install the Scanopy daemon in Proxmox guests that have none (via the hypervisors' forced-command key)
Documentation=file://{{ monitoring_scanopy_onboard_readme_file }}
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
{% for key, value in monitoring_scanopy_onboard_environment | dictsort %}
Environment={{ key }}={{ value }}
{% endfor %}
ExecStart=/usr/bin/python3 {{ monitoring_scanopy_onboard_script_file }}
TimeoutStartSec=1500
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
# known_hosts is written under the config dir the first time a hypervisor is contacted (accept-new).
ReadWritePaths={{ monitoring_scanopy_onboard_textfile_dir }} {{ monitoring_scanopy_onboard_state_dir }} {{ monitoring_scanopy_onboard_config_dir }}
ReadOnlyPaths={{ monitoring_scanopy_onboard_api_key_file | dirname }} {{ monitoring_scanopy_onboard_install_dir }} /opt/scanopy-discover
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

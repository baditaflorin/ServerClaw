[Unit]
Description=Refresh the Scanopy standby database from the newest dump
Documentation=file://{{ monitoring_scanopy_standby_readme_file }}
After=docker.service scanopy-backup.service
Wants=docker.service

[Service]
Type=oneshot
User=root
Environment=BACKUP_DIR={{ monitoring_scanopy_backup_dir }}
ExecStart=/usr/bin/python3 {{ monitoring_scanopy_standby_script_file }} sync
TimeoutStartSec=900
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths={{ monitoring_scanopy_standby_state_dir }} {{ monitoring_scanopy_standby_textfile_dir }}
ReadOnlyPaths={{ monitoring_scanopy_standby_install_dir }} {{ monitoring_scanopy_backup_dir }}
UMask=0077

global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    cluster: {{ monitoring_otel_resource_cluster }}
    environment: {{ monitoring_otel_resource_environment }}

rule_files:
  - {{ monitoring_prometheus_rules_dir }}/*.yml
alerting:
  alertmanagers:
    - static_configs:
        - targets:
{% for target in monitoring_prometheus_alertmanager_targets %}
            - {{ target }}
{% endfor %}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - 127.0.0.1:9090
        labels:
          service: prometheus

  # Alertmanager's own metrics (notification failures, state persistence errors); the blackbox probes below only check liveness.
  - job_name: alertmanager
    metrics_path: /metrics
    static_configs:
      - targets:
{% for target in monitoring_prometheus_alertmanager_targets %}
          - {{ target }}
{% endfor %}
        labels:
          service: alertmanager
          host: monitoring-lv3

  - job_name: tempo
    metrics_path: /metrics
    static_configs:
      - targets:
          - 127.0.0.1:{{ monitoring_tempo_http_port }}
        labels:
          service: tempo

  - job_name: otelcol-contrib
    metrics_path: /metrics
    static_configs:
      - targets:
          - 127.0.0.1:{{ monitoring_otelcol_metrics_port }}
        labels:
          service: otel-collector

  - job_name: loki-canary
    metrics_path: /metrics
    static_configs:
      - targets:
          - 127.0.0.1:{{ monitoring_loki_canary_metrics_port }}
        labels:
          service: loki-canary
          assurance_dimension: log-queryability

  - job_name: {{ monitoring_postgres_audit_metrics_job_name }}
    metrics_path: /metrics
    static_configs:
      - targets:
          - {{ monitoring_postgres_audit_metrics_target }}
        labels:
          service: postgres
          component: pgaudit
    metric_relabel_configs:
      - source_labels: [__name__]
        regex: loki_process_custom_(postgres_(audit_events_total|connection_authorized_total|unknown_connection_events_total))
        target_label: __name__
        replacement: $1

  - job_name: slo-blackbox
    metrics_path: /probe
    file_sd_configs:
      - files:
          - {{ monitoring_prometheus_slo_targets_file }}
    relabel_configs:
{% if monitoring_prometheus_blackbox_drop_address_regex | length > 0 %}
      # Drop catalog placeholder and retired-subnet targets; live targets come from the Scanopy file_sd jobs.
      - source_labels: [__address__]
        regex: {{ monitoring_prometheus_blackbox_drop_address_regex | to_json }}
        action: drop
{% endif %}
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [probe_module]
        target_label: __param_module
      - source_labels: [__param_target]
        target_label: instance
      # Edge-published endpoints are probed through the edge's private address with the public name as Host/SNI
      # (blackbox "hostname" parameter); the monitoring VM cannot reach the public address (no hairpin NAT).
      - source_labels: [probe_hostname]
        target_label: __param_hostname
      - source_labels: [display_url]
        regex: (.+)
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:{{ monitoring_blackbox_exporter_port }}

  - job_name: https-tls-blackbox
    metrics_path: /probe
    file_sd_configs:
      - files:
          - {{ monitoring_prometheus_https_tls_targets_file }}
    relabel_configs:
{% if monitoring_prometheus_blackbox_drop_address_regex | length > 0 %}
      # Drop catalog placeholder and retired-subnet targets; live targets come from the Scanopy file_sd jobs.
      - source_labels: [__address__]
        regex: {{ monitoring_prometheus_blackbox_drop_address_regex | to_json }}
        action: drop
{% endif %}
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [probe_module]
        target_label: __param_module
      - source_labels: [probe_hostname]
        target_label: __param_hostname
      - source_labels: [display_url]
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:{{ monitoring_blackbox_exporter_port }}
{% for service_id, service in monitoring_health_probe_catalog.services | dictsort %}
{% for probe_kind in ['liveness', 'readiness'] %}
{% set probe = service[probe_kind] %}
{% if probe.kind in ['http', 'tcp'] and (monitoring_prometheus_health_probe_service_ids | length == 0 or service_id in monitoring_prometheus_health_probe_service_ids) %}

  - job_name: {{ service_id }}-{{ probe_kind }}
    metrics_path: /probe
    params:
      module:
{% if probe.kind == 'tcp' %}
        - tcp_connect
{% elif probe.validate_tls is defined and not probe.validate_tls %}
        - http_2xx_insecure
{% else %}
        - http_2xx
{% endif %}
    static_configs:
      - targets:
{% if probe.kind == 'http' %}
          - {{ probe.url }}
{% else %}
          - {{ probe.host }}:{{ probe.port }}
{% endif %}
        labels:
          service: {{ service_id }}
          probe_kind: {{ probe_kind }}
          probe_id: {{ service_id }}-{{ probe_kind }}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - target_label: __address__
        replacement: 127.0.0.1:{{ monitoring_blackbox_exporter_port }}
      - source_labels: [__param_target]
        target_label: instance
{% endif %}
{% endfor %}
{% endfor %}
{% if monitoring_prometheus_public_edge_targets_file | length > 0 %}

  - job_name: public-edge-critical
    metrics_path: /probe
    file_sd_configs:
      - files:
          - {{ monitoring_prometheus_public_edge_targets_file }}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [probe_module]
        target_label: __param_module
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:{{ monitoring_blackbox_exporter_port }}
{% endif %}
{% if monitoring_prometheus_extra_scrape_jobs | length > 0 %}

{{ monitoring_prometheus_extra_scrape_jobs | to_nice_yaml(indent=2) | indent(2, true) }}
{% endif %}
{% if monitoring_scanopy_sd_enabled | bool %}

  # BEGIN scanopy-sd: targets are generated from the Scanopy inventory by {{ monitoring_scanopy_sd_script_file }}.
  # The per-host `scanopy_job` label keeps job names that existing rule selectors depend on.
  - job_name: node_exporter
    scrape_interval: 30s
    scrape_timeout: 15s
    file_sd_configs:
      - files:
          - {{ monitoring_scanopy_sd_node_targets_file }}
        refresh_interval: 1m
    relabel_configs:
{% if monitoring_scanopy_sd_node_drop_address_regex | length > 0 %}
      # Exporters kept as static jobs above win; never scrape the same address twice.
      - source_labels: [__address__]
        regex: {{ monitoring_scanopy_sd_node_drop_address_regex | to_json }}
        action: drop
{% endif %}
      - source_labels: [scanopy_job]
        regex: (.+)
        target_label: job
      - regex: scanopy_job
        action: labeldrop
    metric_relabel_configs:
      # cardinality guard: systemd and container-veth families
      - source_labels: [__name__]
        regex: node_systemd_.*
        action: drop
      - source_labels: [__name__, device]
        regex: 'node_network_.*;(veth.*|br-.*|docker0)'
        action: drop

  - job_name: scanopy-blackbox
    metrics_path: /probe
    scrape_interval: 30s
    scrape_timeout: 15s
    file_sd_configs:
      - files:
          - {{ monitoring_scanopy_sd_blackbox_targets_file }}
        refresh_interval: 1m
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [probe_module]
        target_label: __param_module
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:{{ monitoring_blackbox_exporter_port }}
  # END scanopy-sd
{% endif %}
{% if monitoring_prometheus_remote_write_targets | length > 0 %}
remote_write:
{% for target in monitoring_prometheus_remote_write_targets %}
  - url: {{ target.url }}
{% if target.basic_auth is defined %}
    basic_auth:
      username: {{ target.basic_auth.username }}
      password_file: {{ target.basic_auth.password_file }}
{% endif %}
{% if target.queue_config is defined %}
    queue_config:
{% for key, value in target.queue_config | dictsort %}
      {{ key }}: {{ value }}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}

auth_enabled: false

server:
  http_listen_port: {{ monitoring_loki_port }}

common:
  path_prefix: {{ monitoring_loki_data_dir }}
  replication_factor: 1
  ring:
    # instance_addr keeps all intra-process ring traffic on loopback so the
    # querier can resolve the query-scheduler immediately on single-node
    # deployments (Loki 3.x /ready hangs without this if ring traffic tries
    # to route through a non-loopback interface that isn't yet stable).
    instance_addr: 127.0.0.1
    kvstore:
      store: inmemory

schema_config:
  configs:
    - from: "{{ monitoring_loki_filesystem_schema_start_date }}"
      store: tsdb
      object_store: filesystem
      schema: v13
      index:
        prefix: index_
        period: 24h
    - from: "{{ monitoring_loki_minio_schema_cutover_date }}"
      store: tsdb
      object_store: s3
      schema: v13
      index:
        prefix: index_
        period: 24h

storage_config:
  tsdb_shipper:
    active_index_directory: {{ monitoring_loki_data_dir }}/index
    cache_location: {{ monitoring_loki_data_dir }}/index_cache
  filesystem:
    directory: {{ monitoring_loki_data_dir }}/chunks
  aws:
    bucketnames: {{ monitoring_loki_minio_bucket_name }}
    endpoint: {{ monitoring_loki_minio_endpoint }}
    region: {{ monitoring_loki_minio_region }}
    access_key_id: {{ monitoring_loki_minio_access_key_id }}
    secret_access_key: {{ monitoring_loki_minio_secret_key }}
    insecure: true
    s3forcepathstyle: true

limits_config:
  max_query_lookback: {{ monitoring_loki_retention_control_plane }}
  retention_period: {{ monitoring_loki_retention_default }}
  retention_stream:
    - selector: '{lane="control-plane"}'
      priority: 3
      period: {{ monitoring_loki_retention_control_plane }}
    - selector: '{service="nginx",log_type="access"}'
      priority: 2
      period: {{ monitoring_loki_retention_edge_access }}

compactor:
  working_directory: {{ monitoring_loki_data_dir }}/retention
  compaction_interval: 10m
  retention_enabled: true
  delete_request_store: s3

analytics:
  reporting_enabled: false

#!/usr/bin/env bash
# {{ ansible_managed }}
# Platform service health watchdog — ADR 0421
# Watchdog instance: {{ service_watchdog_name }}
# Probes {{ service_watchdog_services | length }} service(s) every {{ service_watchdog_probe_interval_sec }}s.
# Auto-restarts on {{ service_watchdog_failure_threshold }} consecutive failures.
# Rate-limited to {{ service_watchdog_max_restarts_per_hour }} restarts/hour/service.

set -euo pipefail

STATE_DIR="{{ service_watchdog_state_dir }}"
STATUS_FILE="{{ service_watchdog_status_file }}"
PROBE_TIMEOUT="{{ service_watchdog_probe_timeout_sec }}"
FAILURE_THRESHOLD="{{ service_watchdog_failure_threshold }}"
MAX_RESTARTS_PER_HOUR="{{ service_watchdog_max_restarts_per_hour }}"
NTFY_ENABLED="{{ service_watchdog_ntfy_enabled | lower }}"
NTFY_URL="{{ service_watchdog_ntfy_url }}/{{ service_watchdog_ntfy_topic }}"
NTFY_PRIORITY="{{ service_watchdog_ntfy_priority }}"
NTFY_TITLE="{{ service_watchdog_ntfy_title }}"
HOSTNAME="$(hostname -f)"
TIMESTAMP="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

mkdir -p "${STATE_DIR}"

# --- helper functions ---

log_info()  { echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) INFO  $*"; }
log_warn()  { echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) WARN  $*"; }
log_error() { echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) ERROR $*"; }

send_ntfy() {
    local title="$1" message="$2" tags="$3" priority="${4:-${NTFY_PRIORITY}}"
    if [[ "${NTFY_ENABLED}" != "true" ]]; then return 0; fi
    curl -sf -o /dev/null \
        -H "Title: ${title}" \
        -H "Priority: ${priority}" \
        -H "Tags: ${tags}" \
        -d "${message}" \
        "${NTFY_URL}" 2>/dev/null || true
}

get_failure_count() {
    local svc="$1"
    local file="${STATE_DIR}/${svc}.failures"
    if [[ -f "${file}" ]]; then cat "${file}"; else echo 0; fi
}

set_failure_count() {
    local svc="$1" count="$2"
    echo "${count}" > "${STATE_DIR}/${svc}.failures"
}

get_restart_count_this_hour() {
    local svc="$1"
    local file="${STATE_DIR}/${svc}.restarts"
    local current_hour
    current_hour="$(date -u +%Y-%m-%dT%H)"
    if [[ -f "${file}" ]]; then
        local stored_hour stored_count
        stored_hour="$(head -1 "${file}")"
        stored_count="$(tail -1 "${file}")"
        if [[ "${stored_hour}" == "${current_hour}" ]]; then
            echo "${stored_count}"
            return
        fi
    fi
    echo 0
}

increment_restart_count() {
    local svc="$1"
    local file="${STATE_DIR}/${svc}.restarts"
    local current_hour count
    current_hour="$(date -u +%Y-%m-%dT%H)"
    count="$(get_restart_count_this_hour "${svc}")"
    count=$(( count + 1 ))
    printf '%s\n%s\n' "${current_hour}" "${count}" > "${file}"
}

probe_http() {
    local url="$1" method="$2" expected="$3"
    local status_code
    # shellcheck disable=SC2086
    status_code="$(curl -sf -o /dev/null -w '%{http_code}' \
        --max-time "${PROBE_TIMEOUT}" \
        ${method} \
        "${url}" 2>/dev/null)" || status_code="000"
    [[ "${status_code}" == "${expected}" ]]
}

probe_docker_health() {
    local container="$1"
    local state
    state="$(docker inspect --format '{{ '{{' }}.State.Health.Status{{ '}}' }}' "${container}" 2>/dev/null)" || state="missing"
    [[ "${state}" == "healthy" ]]
}

restart_service() {
    local svc="$1" compose_dir="$2" compose_service="$3" restart_args="$4"
    local compose_cmd
    if [[ -z "${restart_args}" ]]; then
        compose_cmd="restart ${compose_service} --timeout 30"
    else
        compose_cmd="${restart_args}"
    fi
    log_warn "${svc}: running 'docker compose ${compose_cmd}' in ${compose_dir}"
    # shellcheck disable=SC2086
    if cd "${compose_dir}" && docker compose ${compose_cmd} 2>&1; then
        log_info "${svc}: restart completed"
        return 0
    else
        log_error "${svc}: restart failed"
        return 1
    fi
}

handle_unhealthy() {
    local svc="$1" compose_dir="$2" compose_service="$3" restart_args="$4" exclude_restart="$5"
    local failures restarts_this_hour

    failures="$(get_failure_count "${svc}")"
    failures=$(( failures + 1 ))
    set_failure_count "${svc}" "${failures}"
    log_warn "${svc}: unhealthy — ${failures} consecutive failure(s)"

    if [[ "${failures}" -lt "${FAILURE_THRESHOLD}" ]]; then
        return 0
    fi

    # Threshold reached
    if [[ "${exclude_restart}" == "true" ]]; then
        log_warn "${svc}: threshold reached but auto-restart excluded (manual intervention required)"
        if [[ "${failures}" -eq "${FAILURE_THRESHOLD}" ]]; then
            send_ntfy \
                "${NTFY_TITLE} — ${svc} DOWN (no auto-restart)" \
                "${svc} on ${HOSTNAME} failed ${failures} consecutive probes. Auto-restart EXCLUDED for this service — manual intervention required." \
                "rotating_light,no_entry"
        fi
        return 0
    fi

    if [[ ! -d "${compose_dir}" ]]; then
        log_error "${svc}: compose directory ${compose_dir} does not exist; refusing restart"
        if [[ "${failures}" -eq "${FAILURE_THRESHOLD}" ]]; then
            send_ntfy \
                "${NTFY_TITLE} — ${svc} unmanaged" \
                "${svc} on ${HOSTNAME} failed ${failures} consecutive probes, but ${compose_dir} does not exist. Auto-restart was skipped." \
                "rotating_light,no_entry"
        fi
        return 0
    fi

    restarts_this_hour="$(get_restart_count_this_hour "${svc}")"

    if [[ "${restarts_this_hour}" -lt "${MAX_RESTARTS_PER_HOUR}" ]]; then
        log_warn "${svc}: threshold reached (${failures}/${FAILURE_THRESHOLD}), attempting restart (${restarts_this_hour}/${MAX_RESTARTS_PER_HOUR} this hour)"
        send_ntfy \
            "${NTFY_TITLE} — ${svc} DOWN" \
            "${svc} failed ${failures} consecutive probes on ${HOSTNAME}. Auto-restarting (${restarts_this_hour}/${MAX_RESTARTS_PER_HOUR} this hour)." \
            "rotating_light,skull"

        if restart_service "${svc}" "${compose_dir}" "${compose_service}" "${restart_args}"; then
            increment_restart_count "${svc}"
            # Give the restarted service a complete failure window to become ready.
            set_failure_count "${svc}" 0
        fi
    else
        log_error "${svc}: restart rate limit reached (${MAX_RESTARTS_PER_HOUR}/hour). Manual intervention required."
        # Only alert once when hitting the limit (avoid spam)
        if [[ "${restarts_this_hour}" -eq "${MAX_RESTARTS_PER_HOUR}" ]]; then
            send_ntfy \
                "${NTFY_TITLE} — ${svc} RESTART LIMIT" \
                "${svc} on ${HOSTNAME} hit restart rate limit (${MAX_RESTARTS_PER_HOUR}/hour). Service is DOWN. Manual intervention required." \
                "rotating_light,sos,skull" "5"
        fi
    fi
}

# --- main probe loop ---

declare -A results
overall_healthy=true

{% for svc in service_watchdog_services %}
# --- {{ svc.name }} ---
{
    svc_name="{{ svc.name }}"
    svc_url="{{ svc.health_url }}"
    svc_method="{{ svc.health_method | default('') }}"
    svc_expected="{{ svc.expected_status }}"
    svc_compose_dir="{{ svc.compose_dir }}"
    svc_compose_service="{{ svc.compose_service | default('') }}"
    svc_restart_args="{{ svc.restart_args | default('') }}"
    svc_exclude_restart="{{ svc.exclude_from_auto_restart | default(false) | lower }}"

    if probe_http "${svc_url}" "${svc_method}" "${svc_expected}"; then
        log_info "${svc_name}: healthy"
        prev_failures="$(get_failure_count "${svc_name}")"
        set_failure_count "${svc_name}" 0
        results["${svc_name}"]="healthy"

        # Recovery notification: only when coming back from a failure state
        if [[ "${prev_failures}" -ge "${FAILURE_THRESHOLD}" ]]; then
            log_info "${svc_name}: recovered after ${prev_failures} consecutive failures"
            send_ntfy \
                "${NTFY_TITLE} — ${svc_name} recovered" \
                "${svc_name} is healthy again on ${HOSTNAME} after ${prev_failures} consecutive failures." \
                "white_check_mark,shield" "3"
        fi
    else
        results["${svc_name}"]="unhealthy"
        overall_healthy=false
        handle_unhealthy \
            "${svc_name}" \
            "${svc_compose_dir}" \
            "${svc_compose_service}" \
            "${svc_restart_args}" \
            "${svc_exclude_restart}"
    fi
}

{% endfor %}

# --- write machine-readable status ---

{
    echo "{"
    echo "  \"timestamp\": \"${TIMESTAMP}\","
    echo "  \"hostname\": \"${HOSTNAME}\","
    echo "  \"watchdog\": \"{{ service_watchdog_name }}\","
    echo "  \"overall_healthy\": ${overall_healthy},"
    echo "  \"services\": {"

{% for svc in service_watchdog_services %}
    echo "    \"{{ svc.name }}\": {"
    echo "      \"status\": \"${results[{{ svc.name }}]:-unknown}\","
    echo "      \"failure_count\": $(get_failure_count "{{ svc.name }}"),"
    echo "      \"restarts_this_hour\": $(get_restart_count_this_hour "{{ svc.name }}")"
    echo "    }{{ ',' if not loop.last else '' }}"
{% endfor %}

    echo "  }"
    echo "}"
} > "${STATUS_FILE}.tmp"
mv "${STATUS_FILE}.tmp" "${STATUS_FILE}"

if [[ "${overall_healthy}" == "true" ]]; then
    log_info "All {{ service_watchdog_services | length }} watched service(s) healthy"
else
    log_warn "One or more watched service(s) unhealthy — see ${STATUS_FILE}"
fi

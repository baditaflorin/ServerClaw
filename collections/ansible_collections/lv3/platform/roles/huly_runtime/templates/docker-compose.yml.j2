# Managed by Ansible — do not edit by hand. Role: lv3.platform.huly_runtime
# Note: This is a simplified deployment of the Huly frontend only.
# Full Huly requires additional backend services. See role defaults for details.
---
services:
  huly-front:
    image: {{ huly_image }}
    container_name: {{ huly_container_name }}
    restart: unless-stopped
    ports:
      - "127.0.0.1:{{ huly_internal_port }}:8080"
    environment:
      SERVER_PORT: "8080"
    volumes:
      - huly-data:/data

volumes:
  huly-data:

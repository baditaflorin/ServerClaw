# managed-by: role=huly_runtime adr=0419 agent={{ lookup('env','LV3_AGENT_SESSION') | default('operator') }}
# Managed by Ansible. Role: lv3.platform.huly_runtime
---
name: {{ huly_project_name }}

services:
  nginx:
    image: nginx:1.21.3
    restart: unless-stopped
    ports:
      - "{{ huly_http_bind }}:{{ huly_internal_port }}:80"
    volumes:
      - ./.huly.nginx:/etc/nginx/conf.d/default.conf:ro
    networks:
      - huly_net

  cockroach:
    image: cockroachdb/cockroach:latest-v24.2
    command: start-single-node --accept-sql-without-tls
    environment:
      - COCKROACH_DATABASE=${CR_DATABASE}
      - COCKROACH_USER=${CR_USERNAME}
      - COCKROACH_PASSWORD=${CR_USER_PASSWORD}
    volumes:
      - cr_data:/cockroach/cockroach-data
      - cr_certs:/cockroach/certs
    restart: unless-stopped
    networks:
      - huly_net

  redpanda:
    image: docker.redpanda.com/redpandadata/redpanda:v24.3.6
    command:
      - redpanda
      - start
      - --kafka-addr
      - internal://0.0.0.0:9092,external://0.0.0.0:19092
      - --advertise-kafka-addr
      - internal://redpanda:9092,external://localhost:19092
      - --pandaproxy-addr
      - internal://0.0.0.0:8082,external://0.0.0.0:18082
      - --advertise-pandaproxy-addr
      - internal://redpanda:8082,external://localhost:18082
      - --schema-registry-addr
      - internal://0.0.0.0:8081,external://0.0.0.0:18081
      - --rpc-addr
      - redpanda:33145
      - --advertise-rpc-addr
      - redpanda:33145
      - --mode
      - dev-container
      - --smp
      - "1"
      - --default-log-level=info
    volumes:
      - redpanda:/var/lib/redpanda/data
    environment:
      - REDPANDA_SUPERUSER_USERNAME=${REDPANDA_ADMIN_USER}
      - REDPANDA_SUPERUSER_PASSWORD=${REDPANDA_ADMIN_PWD}
    healthcheck:
      test: ["CMD", "rpk", "cluster", "info"]
      interval: 10s
      timeout: 5s
      retries: 10
    restart: unless-stopped
    networks:
      - huly_net

  minio:
    image: minio/minio
    command: server /data --address ":9000" --console-address ":9001"
    volumes:
      - files:/data
    healthcheck:
      test: ["CMD", "mc", "ready", "local"]
      interval: 5s
      retries: 10
    restart: unless-stopped
    networks:
      - huly_net

  elastic:
    image: elasticsearch:7.14.2
    command: >
      /bin/sh -c "./bin/elasticsearch-plugin list | grep -q ingest-attachment ||
      yes | ./bin/elasticsearch-plugin install --silent ingest-attachment;
      /usr/local/bin/docker-entrypoint.sh eswrapper"
    volumes:
      - elastic:/usr/share/elasticsearch/data
    environment:
      - ELASTICSEARCH_PORT_NUMBER=9200
      - BITNAMI_DEBUG=true
      - discovery.type=single-node
      - ES_JAVA_OPTS=-Xms1024m -Xmx1024m
      - http.cors.enabled=true
      - http.cors.allow-origin=http://localhost:8082
    healthcheck:
      interval: 20s
      retries: 10
      test: curl -s http://localhost:9200/_cluster/health | grep -vq '"status":"red"'
    restart: unless-stopped
    networks:
      - huly_net

  rekoni:
    image: hardcoreeng/rekoni-service:${HULY_VERSION}
    environment:
      - SECRET=${SECRET}
    deploy:
      resources:
        limits:
          memory: 500M
    restart: unless-stopped
    networks:
      - huly_net

  transactor:
    image: hardcoreeng/transactor:${HULY_VERSION}
    environment:
      - SERVER_PORT=3333
      - SERVER_SECRET=${SECRET}
      - DB_URL=${CR_DB_URL}
      - STORAGE_CONFIG=minio|minio?accessKey=minioadmin&secretKey=minioadmin
      - FRONT_URL=${PUBLIC_URL}
      - ACCOUNTS_URL=http://account:3000
      - FULLTEXT_URL=http://fulltext:4700
      - STATS_URL=http://stats:4900
      - LAST_NAME_FIRST=${LAST_NAME_FIRST}
      - QUEUE_CONFIG=redpanda:9092
    restart: unless-stopped
    networks:
      - huly_net

  collaborator:
    image: hardcoreeng/collaborator:${HULY_VERSION}
    environment:
      - COLLABORATOR_PORT=3078
      - SECRET=${SECRET}
      - ACCOUNTS_URL=http://account:3000
      - STATS_URL=http://stats:4900
      - STORAGE_CONFIG=minio|minio?accessKey=minioadmin&secretKey=minioadmin
    restart: unless-stopped
    networks:
      - huly_net

  account:
    image: hardcoreeng/account:${HULY_VERSION}
    environment:
      - SERVER_PORT=3000
      - SERVER_SECRET=${SECRET}
      - DB_URL=${CR_DB_URL}
      - TRANSACTOR_URL=ws://transactor:3333;wss://${HOST_ADDRESS}/_transactor
      - STORAGE_CONFIG=minio|minio?accessKey=minioadmin&secretKey=minioadmin
      - FRONT_URL=${PUBLIC_URL}
      - STATS_URL=${PUBLIC_URL}/_stats
      - MODEL_ENABLED=*
      - ACCOUNTS_URL=${PUBLIC_URL}/_accounts
      - ACCOUNT_PORT=3000
      - QUEUE_CONFIG=redpanda:9092
    restart: unless-stopped
    networks:
      - huly_net

  workspace:
    image: hardcoreeng/workspace:${HULY_VERSION}
    environment:
      - SERVER_SECRET=${SECRET}
      - DB_URL=${CR_DB_URL}
      - TRANSACTOR_URL=ws://transactor:3333;wss://${HOST_ADDRESS}/_transactor
      - STORAGE_CONFIG=minio|minio?accessKey=minioadmin&secretKey=minioadmin
      - MODEL_ENABLED=*
      - ACCOUNTS_URL=http://account:3000
      - STATS_URL=http://stats:4900
      - QUEUE_CONFIG=redpanda:9092
      - ACCOUNTS_DB_URL=${CR_DB_URL}
    restart: unless-stopped
    networks:
      - huly_net

  front:
    image: hardcoreeng/front:${HULY_VERSION}
    environment:
      - SERVER_PORT=8080
      - SERVER_SECRET=${SECRET}
      - LOVE_ENDPOINT=${PUBLIC_URL}/_love
      - ACCOUNTS_URL=${PUBLIC_URL}/_accounts
      - ACCOUNTS_URL_INTERNAL=http://account:3000
      - REKONI_URL=${PUBLIC_URL}/_rekoni
      - CALENDAR_URL=${PUBLIC_URL}/_calendar
      - GMAIL_URL=${PUBLIC_URL}/_gmail
      - TELEGRAM_URL=${PUBLIC_URL}/_telegram
      - GITHUB_APP=${GITHUB_APP}
      - STATS_URL=${PUBLIC_URL}/_stats
      - UPLOAD_URL=/files
      - ELASTIC_URL=http://elastic:9200
      - COLLABORATOR_URL=wss://${HOST_ADDRESS}/_collaborator
      - STORAGE_CONFIG=minio|minio?accessKey=minioadmin&secretKey=minioadmin
      - TITLE=${TITLE}
      - DEFAULT_LANGUAGE=${DEFAULT_LANGUAGE}
      - LAST_NAME_FIRST=${LAST_NAME_FIRST}
      - DESKTOP_UPDATES_CHANNEL=${DESKTOP_CHANNEL}
      - DISABLED_FEATURES=auto-translate,mailboxes
    restart: unless-stopped
    networks:
      - huly_net

  fulltext:
    image: hardcoreeng/fulltext:${HULY_VERSION}
    environment:
      - SERVER_SECRET=${SECRET}
      - DB_URL=${CR_DB_URL}
      - FULLTEXT_DB_URL=http://elastic:9200
      - ELASTIC_INDEX_NAME=huly_storage_index
      - STORAGE_CONFIG=minio|minio?accessKey=minioadmin&secretKey=minioadmin
      - REKONI_URL=http://rekoni:4004
      - ACCOUNTS_URL=http://account:3000
      - STATS_URL=http://stats:4900
      - QUEUE_CONFIG=redpanda:9092
    restart: unless-stopped
    networks:
      - huly_net

  stats:
    image: hardcoreeng/stats:${HULY_VERSION}
    environment:
      - PORT=4900
      - SERVER_SECRET=${SECRET}
    restart: unless-stopped
    networks:
      - huly_net

  kvs:
    image: hardcoreeng/hulykvs:${HULY_VERSION}
    depends_on:
      cockroach:
        condition: service_started
    environment:
      - HULY_DB_CONNECTION=${CR_DB_URL}
      - HULY_TOKEN_SECRET=${SECRET}
    restart: unless-stopped
    networks:
      - huly_net

{% if huly_google_client_id and huly_google_credentials %}
  # Google Calendar integration (activated: GOOGLE_CLIENT_ID + GOOGLE_CREDENTIALS are set)
  calendar:
    image: hardcoreeng/calendar:${HULY_VERSION}
    restart: unless-stopped
    environment:
      - CALENDAR_PORT=8095
      - SECRET=${SECRET}
      - ACCOUNTS_URL=http://account:3000
      - DB_URL=${CR_DB_URL}
      - COLLABORATOR_URL=http://collaborator:3078
      - GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
      - GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET}
      - Credentials=${GOOGLE_CREDENTIALS}
      - WATCH_URL=${CALENDAR_WATCH_URL}
      - KVS_URL=${KVS_URL}
    networks:
      - huly_net
{% endif %}

{% if huly_google_client_id and huly_google_credentials and huly_gmail_watch_topic %}
  # Gmail integration (activated: GOOGLE_CREDENTIALS + GMAIL_WATCH_TOPIC_NAME are set)
  gmail:
    image: hardcoreeng/gmail:${HULY_VERSION}
    restart: unless-stopped
    environment:
      - GMAIL_PORT=8088
      - SECRET=${SECRET}
      - ACCOUNTS_URL=http://account:3000
      - DB_URL=${CR_DB_URL}
      - GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
      - GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET}
      - Credentials=${GOOGLE_CREDENTIALS}
      - WATCH_URL=${CALENDAR_WATCH_URL}
      - KVS_URL=${KVS_URL}
      - WATCH_TOPIC_NAME=${GMAIL_WATCH_TOPIC_NAME}
      - STORAGE_CONFIG=minio|minio?accessKey=minioadmin&secretKey=minioadmin
    networks:
      - huly_net
{% endif %}

{% if huly_telegram_bot_token and huly_telegram_api_id and huly_telegram_mongo_uri %}
  # MongoDB — session store for Telegram MTProto (activated alongside telegram service)
  mongo:
    image: mongo:7
    restart: unless-stopped
    volumes:
      - mongo_data:/data/db
    networks:
      - huly_net

  # Telegram integration (activated: BOT_TOKEN + MTProto API credentials + MONGO_URI are set)
  telegram:
    image: hardcoreeng/telegram:${HULY_VERSION}
    restart: unless-stopped
    depends_on:
      - mongo
    environment:
      - TELEGRAM_PORT=8086
      - SECRET=${SECRET}
      - ACCOUNTS_URL=http://account:3000
      - DB_URL=${CR_DB_URL}
      - BOT_TOKEN=${TELEGRAM_BOT_TOKEN}
      - TELEGRAM_API_ID=${TELEGRAM_API_ID}
      - TELEGRAM_API_HASH=${TELEGRAM_API_HASH}
      - MONGO_URI=${MONGO_URI}
      - STORAGE_CONFIG=minio|minio?accessKey=minioadmin&secretKey=minioadmin
    networks:
      - huly_net
{% endif %}

{% if huly_github_app_id %}
  # GitHub integration (activated: GITHUB_APP_ID is set)
  github:
    image: hardcoreeng/github:${HULY_VERSION}
    restart: unless-stopped
    environment:
      - GITHUB_PORT=8083
      - SERVER_SECRET=${SECRET}
      - ACCOUNTS_URL=http://account:3000
      - DB_URL=${CR_DB_URL}
      - COLLABORATOR_URL=http://collaborator:3078
      - APP_ID=${GITHUB_APP_ID}
      - CLIENT_ID=${GITHUB_CLIENT_ID}
      - CLIENT_SECRET=${GITHUB_CLIENT_SECRET}
      - PRIVATE_KEY=${GITHUB_PRIVATE_KEY}
      - INSTALLATION_URL=${GITHUB_INSTALLATION_URL}
      - STORAGE_CONFIG=minio|minio?accessKey=minioadmin&secretKey=minioadmin
    networks:
      - huly_net
{% endif %}

{% set huly_edge_nginx_ipv4 = (hostvars[platform_topology_host].proxmox_guests | selectattr('name', 'equalto', 'nginx-lv3') | map(attribute='ipv4') | first) %}
{% if huly_automation_token and huly_task_bot_telegram_token %}
  # Telegram task bot — /tasks lists issues, /add creates one (own bot token,
  # separate from the telegram service above; see docs/runbooks/huly-api-access.md)
  #
  # extra_hosts: the Huly API client always calls back out to PUBLIC_URL for
  # account/config discovery (baked into the front service's own config.json,
  # not overridable via client options). Routing that hostname straight to
  # the edge nginx VM's internal IP avoids a Docker hairpin-NAT loop back
  # through the platform's own public IP, which containers here can't reach
  # (confirmed: containers reach arbitrary internet hosts fine, but get
  # ECONNREFUSED specifically on this host's own public IP).
  task-bot:
    image: node:20-alpine
    restart: unless-stopped
    working_dir: /app
    command: sh -c "npm install --omit=dev && node bot.js"
    volumes:
      - ./task-bot:/app
    extra_hosts:
      - "{{ huly_external_host }}:{{ huly_edge_nginx_ipv4 }}"
    environment:
      - HULY_URL=${PUBLIC_URL}
      - HULY_TOKEN=${HULY_AUTOMATION_TOKEN}
      - HULY_WORKSPACE=${HULY_AUTOMATION_WORKSPACE}
      - HULY_PROJECT_IDENTIFIER=${HULY_TASK_BOT_PROJECT_IDENTIFIER}
      - TELEGRAM_BOT_TOKEN=${HULY_TASK_BOT_TELEGRAM_TOKEN}
      - TELEGRAM_ALLOWED_USER_ID=${HULY_TASK_BOT_ALLOWED_USER_ID}
    networks:
      - huly_net
{% endif %}

{% if huly_gmail_watcher_active %}
  # Gmail tag-based task creator — subject "[tag]" -> Huly project, see
  # docs/runbooks/huly-api-access.md §5. Same hairpin-NAT extra_hosts fix as
  # task-bot above.
  gmail-task-watcher:
    image: node:20-alpine
    restart: unless-stopped
    working_dir: /app
    command: sh -c "npm install --omit=dev && node watcher.js"
    volumes:
      - ./gmail-task-watcher:/app
      - gmail_watcher_state:/data
    extra_hosts:
      - "{{ huly_external_host }}:{{ huly_edge_nginx_ipv4 }}"
    environment:
      - HULY_URL=${PUBLIC_URL}
      - HULY_TOKEN=${HULY_AUTOMATION_TOKEN}
      - HULY_WORKSPACE=${HULY_AUTOMATION_WORKSPACE}
      - GOOGLE_CLIENT_ID=${GMAIL_WATCHER_CLIENT_ID}
      - GOOGLE_CLIENT_SECRET=${GMAIL_WATCHER_CLIENT_SECRET}
      - GOOGLE_REFRESH_TOKEN=${GMAIL_WATCHER_REFRESH_TOKEN}
      - GOOGLE_APPLICATION_CREDENTIALS=/app/service-account.json
      - GCP_PROJECT_ID=${GMAIL_WATCHER_GCP_PROJECT_ID}
      - PUBSUB_SUBSCRIPTION=${GMAIL_WATCHER_PUBSUB_SUBSCRIPTION}
      - GMAIL_TASK_RULES_FILE=/app/rules.json
      - STATE_FILE=/data/state.json
    networks:
      - huly_net
{% endif %}

volumes:
  elastic:
  files:
  cr_data:
  cr_certs:
  redpanda:
{% if huly_telegram_bot_token and huly_telegram_api_id and huly_telegram_mongo_uri %}
  mongo_data:
{% endif %}
{% if huly_gmail_watcher_active %}
  gmail_watcher_state:
{% endif %}

networks:
  huly_net:

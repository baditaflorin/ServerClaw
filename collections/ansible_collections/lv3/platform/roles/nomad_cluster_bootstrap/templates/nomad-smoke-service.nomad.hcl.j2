{# Rendered by lv3.platform.nomad_cluster_bootstrap (ADR 0438). #}
{# Single source of truth for the smoke service job; per-deployment naming  #}
{# is derived from platform_identity.config_prefix. Do not edit the rendered #}
{# .hcl files in config/nomad/jobs/ directly. #}
job "{{ nomad_cluster_bootstrap_smoke_service_job_name }}" {
  region      = "global"
  datacenters = ["dc1"]
  type        = "service"

  constraint {
    attribute = "${node.class}"
    operator  = "="
    value     = "build"
  }

  group "http" {
    count = 1

    network {
      mode = "host"

      port "http" {
        static = {{ nomad_cluster_bootstrap_smoke_service_port }}
      }
    }

    restart {
      attempts = 10
      interval = "30m"
      delay    = "15s"
      mode     = "delay"
    }

    task "http" {
      driver = "docker"

      config {
        image   = "python:3.13-alpine3.22"
        command = "sh"
        args = [
          "-lc",
          "mkdir -p /srv/www && printf '{{ nomad_cluster_bootstrap_smoke_service_expected_text }}\\n' > /srv/www/index.html && exec python3 -m http.server {{ nomad_cluster_bootstrap_smoke_service_port }} --bind 0.0.0.0 --directory /srv/www",
        ]
        ports = ["http"]
      }

      resources {
        cpu    = 100
        memory = 128
      }

      service {
        name = "{{ nomad_cluster_bootstrap_smoke_service_job_name }}"
        provider = "nomad"
        port = "http"
        tags = ["repo-managed", "adr-0232", "smoke"]
      }
    }
  }
}
